{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wcmc-reciterai-artifacts.s3.amazonaws.com/spotlight/latest/spotlight.schema.json",
  "title": "ReCiter AI Spotlight Artifact",
  "description": "JSON Schema Draft 2020-12 for the spotlight.json artifact published by Phase 6 Spotlight Pipeline. Validates the 10-active-spotlight + 50-pool-snapshot shape with first/last author payloads keyed for SPS headshot resolution. Additive non-breaking rule per Phase 5 D-11: no additionalProperties:false at any level.",
  "$defs": {
    "_meta": {
      "schema_version": "1.0.0"
    },
    "Author": {
      "type": "object",
      "required": ["personIdentifier", "displayName", "position"],
      "properties": {
        "personIdentifier": {
          "type": "string",
          "minLength": 1,
          "description": "WCM faculty UID; SPS photo-store join key."
        },
        "displayName": {
          "type": "string"
        },
        "position": {
          "type": "string",
          "enum": ["first", "last"]
        }
      }
    },
    "Paper": {
      "type": "object",
      "required": ["pmid", "title", "journal", "year", "first_author", "last_author"],
      "properties": {
        "pmid": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "title": {
          "type": "string"
        },
        "journal": {
          "type": "string"
        },
        "year": {
          "type": "integer",
          "minimum": 1900,
          "maximum": 2100
        },
        "first_author": {
          "$ref": "#/$defs/Author"
        },
        "last_author": {
          "$ref": "#/$defs/Author"
        }
      }
    },
    "Spotlight": {
      "type": "object",
      "required": ["subtopic_id", "label", "parent_topic", "lede", "papers"],
      "properties": {
        "subtopic_id": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "description": "LLM-canonical subtopic label (D-19 — used as identity)."
        },
        "display_name": {
          "type": "string",
          "description": "UI-facing label (D-19 — UI-only; falls back to label if absent)."
        },
        "short_description": {
          "type": "string"
        },
        "parent_topic": {
          "type": "string",
          "minLength": 1
        },
        "lede": {
          "type": "string",
          "minLength": 22,
          "maxLength": 800,
          "description": "Editorial lede; 22-38 words enforced upstream by critic regex bundle (length range here is byte bounds, not word bounds)."
        },
        "papers": {
          "type": "array",
          "minItems": 2,
          "maxItems": 7,
          "items": {
            "$ref": "#/$defs/Paper"
          }
        },
        "lede_grounded_pmids": {
          "type": "array",
          "minItems": 2,
          "maxItems": 3,
          "items": {
            "type": "string",
            "pattern": "^[0-9]+$"
          },
          "description": "PMIDs the lede grounded against (editorial subset of papers). Must be a subset of papers[].pmid."
        }
      }
    },
    "PoolSnapshot": {
      "type": "object",
      "required": ["subtopic_id", "pool_score", "parent_topic", "was_selected"],
      "properties": {
        "subtopic_id": {
          "type": "string"
        },
        "pool_score": {
          "type": "number",
          "minimum": 0
        },
        "parent_topic": {
          "type": "string"
        },
        "was_selected": {
          "type": "boolean"
        }
      }
    }
  },
  "type": "object",
  "required": ["version", "generated_at", "taxonomy_version", "spotlights", "pool_snapshot"],
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^spotlight_v[0-9]+$"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 UTC with Z suffix."
    },
    "taxonomy_version": {
      "type": "string",
      "minLength": 1
    },
    "spotlights": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "description": "Active spotlights for the publish run. Up to 10 (CONTEXT decision Q1.1).",
      "items": {
        "$ref": "#/$defs/Spotlight"
      }
    },
    "pool_snapshot": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "description": "Top-50 pool ranking snapshot for transparency.",
      "items": {
        "$ref": "#/$defs/PoolSnapshot"
      }
    }
  }
}
