{
  "Comment": "ReciterAI hot path (Phase 10). Weekly cron: score, assign, and rollup the publication-date delta plus the orchestrator's state-based retry sweep (failed PMIDs that aged out of the delta window). NEVER mints versions; that is the cold path's job (spec §2). State machine owns STAGE# row writes via DynamoDB:PutItem SDK integration (D-07), so a Python crash between work-done and row-written cannot lose the completion signal. Pre-run-in-progress lock via ListExecutions in Orchestrate (Open Q5). DeriveDirtyTopics derives the per-topic assign work from the scored delta; AssignFanOut and RollupFanOut are per-item Step Functions Maps. CheckAssignNeeded / CheckRollupNeeded route an empty work set past its Map via a typed skipped envelope (#119).",
  "StartAt": "Orchestrate",
  "States": {
    "Orchestrate": {
      "Type": "Task",
      "Resource": "${OrchestratorLambdaArn}",
      "Parameters": {
        "state_machine_arn.$": "$$.StateMachine.Id",
        "execution_arn.$": "$$.Execution.Id",
        "run_id.$": "$$.Execution.Name",
        "sfn_input.$": "$"
      },
      "ResultPath": "$.orchestrate",
      "Retry": [
        {
          "ErrorEquals": ["Lambda.ServiceException", "Lambda.AWSLambdaException", "Lambda.SdkClientException"],
          "IntervalSeconds": 5,
          "MaxAttempts": 2,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "WriteHotRunFailed"
        }
      ],
      "Next": "CheckLockOrProceed"
    },

    "CheckLockOrProceed": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.orchestrate.status",
          "StringEquals": "skipped",
          "Next": "End"
        }
      ],
      "Default": "Score"
    },

    "Score": {
      "Type": "Task",
      "Resource": "${ScoreLambdaArn}",
      "InputPath": "$.orchestrate.input",
      "ResultPath": "$.score_envelope",
      "Retry": [
        {
          "ErrorEquals": ["Lambda.ServiceException", "Lambda.AWSLambdaException", "Lambda.SdkClientException"],
          "IntervalSeconds": 10,
          "MaxAttempts": 2,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "WriteHotRunFailed"
        }
      ],
      "Next": "WriteScoreStageRow"
    },

    "WriteScoreStageRow": {
      "Type": "Task",
      "Resource": "arn:aws:states:::dynamodb:putItem",
      "Parameters": {
        "TableName": "reciterai",
        "Item.$": "$.score_envelope"
      },
      "ResultPath": null,
      "Next": "DeriveDirtyTopics"
    },

    "DeriveDirtyTopics": {
      "Type": "Task",
      "Comment": "Groups the delta PMIDs' scored TOPIC# rows (PmidIndex GSI) by topic, dropping topics with no approved hierarchy draft. Produces the assign_topics array AssignFanOut iterates and the assign_input_hash BuildAssignSummary stamps. Reuses the onboarding DeriveDirtyTopics Lambda — the {pmids} event routes to its PMID-keyed mode (#119).",
      "Resource": "${DeriveDirtyTopicsLambdaArn}",
      "Parameters": {
        "pmids.$": "$.orchestrate.input.delta.all_pmids"
      },
      "ResultPath": "$.assign",
      "Retry": [
        {
          "ErrorEquals": ["Lambda.ServiceException", "Lambda.AWSLambdaException", "Lambda.SdkClientException"],
          "IntervalSeconds": 10,
          "MaxAttempts": 2,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "WriteHotRunFailed"
        }
      ],
      "Next": "CheckAssignNeeded"
    },

    "CheckAssignNeeded": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.assign.assign_topics[0]",
          "IsPresent": false,
          "Next": "AssignSkipped"
        }
      ],
      "Default": "AssignFanOut"
    },

    "AssignSkipped": {
      "Type": "Pass",
      "Comment": "Stub envelope when DeriveDirtyTopics produced no dirty topics with an approved hierarchy draft. Already in DDB attribute-typed format so WriteHotRunComplete's $.assign_envelope.input_hash.S extraction works.",
      "Result": {
        "PK": {"S": "STAGE#assign_subtopics#GLOBAL"},
        "SK": {"S": "RUN#skipped-no-assign-topics"},
        "stage": {"S": "assign_subtopics"},
        "scope": {"S": "GLOBAL"},
        "status": {"S": "skipped"},
        "skip_reason": {"S": "the delta produced no dirty topics with an approved hierarchy draft"},
        "input_hash": {"S": "skipped:no-assign-topics"}
      },
      "ResultPath": "$.assign_envelope",
      "Next": "TopTopic"
    },

    "AssignFanOut": {
      "Type": "Map",
      "Comment": "Per-topic fan-out (#119). One iteration per dirty topic: AssignOne runs reciterai-hot-assign for that topic's PMIDs, then WriteAssignStageRowOne writes that topic's STAGE#assign_subtopics#topic row (D-07 crash-safety). BuildAssignSummary then synthesizes the single envelope WriteHotRunComplete reads. MaxConcurrency bounds concurrent Bedrock + DynamoDB load.",
      "ItemsPath": "$.assign.assign_topics",
      "MaxConcurrency": 4,
      "ItemProcessor": {
        "ProcessorConfig": {
          "Mode": "INLINE"
        },
        "StartAt": "AssignOne",
        "States": {
          "AssignOne": {
            "Type": "Task",
            "Comment": "Reused hot Lambda reciterai-hot-assign; its {topic_id, delta_pmids} event contract is exactly the Map item.",
            "Resource": "${AssignLambdaArn}",
            "Parameters": {
              "topic_id.$": "$.topic_id",
              "delta_pmids.$": "$.delta_pmids"
            },
            "ResultPath": "$.assign_one_envelope",
            "Retry": [
              {
                "ErrorEquals": ["Lambda.ServiceException", "Lambda.AWSLambdaException", "Lambda.SdkClientException"],
                "IntervalSeconds": 10,
                "MaxAttempts": 2,
                "BackoffRate": 2.0
              }
            ],
            "Next": "WriteAssignStageRowOne"
          },
          "WriteAssignStageRowOne": {
            "Type": "Task",
            "Comment": "Per-topic STAGE#assign_subtopics#topic:{topic} row, written inside the iteration so each topic's audit row lands as its assign completes (D-07).",
            "Resource": "arn:aws:states:::dynamodb:putItem",
            "Parameters": {
              "TableName": "reciterai",
              "Item.$": "$.assign_one_envelope"
            },
            "ResultPath": null,
            "End": true
          }
        }
      },
      "ResultPath": "$.assign_map",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "WriteHotRunFailed"
        }
      ],
      "Next": "BuildAssignSummary"
    },

    "BuildAssignSummary": {
      "Type": "Pass",
      "Comment": "Synthesizes the single $.assign_envelope WriteHotRunComplete reads (input_hash -> the hot_run row's assign_input_hash). The real per-topic detail is the N STAGE#assign_subtopics#topic rows the Map wrote; topic_count is States.ArrayLength of the Map output.",
      "Parameters": {
        "PK": {"S": "STAGE#assign_subtopics#GLOBAL"},
        "SK": {"S": "RUN#hot-assign-fanout"},
        "stage": {"S": "assign_subtopics"},
        "scope": {"S": "GLOBAL"},
        "status": {"S": "complete"},
        "input_hash": {"S.$": "$.assign.assign_input_hash"},
        "topic_count": {"N.$": "States.Format('{}', States.ArrayLength($.assign_map))"}
      },
      "ResultPath": "$.assign_envelope",
      "Next": "TopTopic"
    },

    "TopTopic": {
      "Type": "Task",
      "Resource": "${TopTopicLambdaArn}",
      "Parameters": {
        "delta_pmids.$": "$.orchestrate.input.delta.all_pmids"
      },
      "ResultPath": "$.top_topic_envelope",
      "Retry": [
        {
          "ErrorEquals": ["Lambda.ServiceException", "Lambda.AWSLambdaException", "Lambda.SdkClientException"],
          "IntervalSeconds": 10,
          "MaxAttempts": 2,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "WriteHotRunFailed"
        }
      ],
      "Next": "WriteTopTopicStageRow"
    },

    "WriteTopTopicStageRow": {
      "Type": "Task",
      "Resource": "arn:aws:states:::dynamodb:putItem",
      "Parameters": {
        "TableName": "reciterai",
        "Item.$": "$.top_topic_envelope"
      },
      "ResultPath": null,
      "Next": "CheckRollupNeeded"
    },

    "CheckRollupNeeded": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.orchestrate.input.delta.dirty_cwids[0]",
          "IsPresent": false,
          "Next": "RollupSkipped"
        }
      ],
      "Default": "RollupFanOut"
    },

    "RollupSkipped": {
      "Type": "Pass",
      "Comment": "Stub envelope when delta.dirty_cwids is empty (the delta intersected no faculty publications). Same typing rationale as AssignSkipped.",
      "Result": {
        "PK": {"S": "STAGE#rollup_by_cwid#GLOBAL"},
        "SK": {"S": "RUN#skipped-no-dirty-cwids"},
        "stage": {"S": "rollup_by_cwid"},
        "scope": {"S": "GLOBAL"},
        "status": {"S": "skipped"},
        "skip_reason": {"S": "the delta intersected no faculty publications"},
        "input_hash": {"S": "skipped:no-dirty-cwids"}
      },
      "ResultPath": "$.rollup_envelope",
      "Next": "WriteHotRunComplete"
    },

    "RollupFanOut": {
      "Type": "Map",
      "Comment": "Per-CWID fan-out (#119). One iteration per dirty CWID: RollupOne runs reciterai-hot-rollup in its {cwid} DynamoDB-sourced mode (rollup_by_cwid --cwid), then WriteRollupStageRowOne writes that CWID's STAGE#rollup_by_cwid#cwid row (D-07). BuildRollupSummary then synthesizes the single envelope WriteHotRunComplete reads. MaxConcurrency bounds concurrent DynamoDB load.",
      "ItemsPath": "$.orchestrate.input.delta.dirty_cwids",
      "MaxConcurrency": 4,
      "ItemProcessor": {
        "ProcessorConfig": {
          "Mode": "INLINE"
        },
        "StartAt": "RollupOne",
        "States": {
          "RollupOne": {
            "Type": "Task",
            "Comment": "Reused hot Lambda reciterai-hot-rollup; the Map item is a bare CWID string, so {cwid.$: $} routes to the PMID-aware rollup_by_cwid --cwid path.",
            "Resource": "${RollupLambdaArn}",
            "Parameters": {
              "cwid.$": "$"
            },
            "ResultPath": "$.rollup_one_envelope",
            "Retry": [
              {
                "ErrorEquals": ["Lambda.ServiceException", "Lambda.AWSLambdaException", "Lambda.SdkClientException"],
                "IntervalSeconds": 10,
                "MaxAttempts": 2,
                "BackoffRate": 2.0
              }
            ],
            "Next": "WriteRollupStageRowOne"
          },
          "WriteRollupStageRowOne": {
            "Type": "Task",
            "Comment": "Per-CWID STAGE#rollup_by_cwid#cwid:{cwid} row, written inside the iteration so each CWID's audit row lands as its rollup completes (D-07).",
            "Resource": "arn:aws:states:::dynamodb:putItem",
            "Parameters": {
              "TableName": "reciterai",
              "Item.$": "$.rollup_one_envelope"
            },
            "ResultPath": null,
            "End": true
          }
        }
      },
      "ResultPath": "$.rollup_map",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "WriteHotRunFailed"
        }
      ],
      "Next": "BuildRollupSummary"
    },

    "BuildRollupSummary": {
      "Type": "Pass",
      "Comment": "Synthesizes the single $.rollup_envelope WriteHotRunComplete reads (input_hash -> the hot_run row's rollup_input_hash). The real per-CWID detail is the N STAGE#rollup_by_cwid#cwid rows the Map wrote; input_hash is the orchestrator's run-level rollup_input_hash; cwid_count is States.ArrayLength of the Map output.",
      "Parameters": {
        "PK": {"S": "STAGE#rollup_by_cwid#GLOBAL"},
        "SK": {"S": "RUN#hot-rollup-fanout"},
        "stage": {"S": "rollup_by_cwid"},
        "scope": {"S": "GLOBAL"},
        "status": {"S": "complete"},
        "input_hash": {"S.$": "$.orchestrate.input.delta.rollup_input_hash"},
        "cwid_count": {"N.$": "States.Format('{}', States.ArrayLength($.rollup_map))"}
      },
      "ResultPath": "$.rollup_envelope",
      "Next": "WriteHotRunComplete"
    },

    "WriteHotRunComplete": {
      "Type": "Task",
      "Resource": "arn:aws:states:::dynamodb:putItem",
      "Parameters": {
        "TableName": "reciterai",
        "Item": {
          "PK": {"S": "STAGE#hot_run#GLOBAL"},
          "SK.$": "States.Format('RUN#{}', $.orchestrate.input.started_at)",
          "stage": {"S": "hot_run"},
          "scope": {"S": "GLOBAL"},
          "status": {"S": "complete"},
          "started_at.$": "$.orchestrate.input.started_at",
          "run_id.$": "$.orchestrate.input.run_id",
          "delta_size": {"N.$": "States.Format('{}', $.orchestrate.input.delta.size)"},
          "retry_size": {"N.$": "States.Format('{}', $.orchestrate.input.delta.retry_size)"},
          "run_kind": {"S.$": "$.orchestrate.input.run_kind"},
          "score_input_hash": {"S.$": "$.score_envelope.input_hash.S"},
          "assign_input_hash": {"S.$": "$.assign_envelope.input_hash.S"},
          "top_topic_input_hash": {"S.$": "$.top_topic_envelope.input_hash.S"},
          "rollup_input_hash": {"S.$": "$.rollup_envelope.input_hash.S"}
        }
      },
      "ResultPath": null,
      "Next": "CheckStageSkipAnomaly"
    },

    "CheckStageSkipAnomaly": {
      "Type": "Choice",
      "Comment": "#121 — a run with real input (a non-empty delta or retry-sweep set) that nonetheless skipped Assign or Rollup is flagged. The skip sentinels (skipped:no-assign-topics / skipped:no-dirty-cwids) are otherwise a passive signal nobody reads. A legitimately empty skip — no draft-covered topics, or the delta intersected no faculty — yields a dismissible WARN; the cost asymmetry favours over-alerting.",
      "Choices": [
        {
          "And": [
            {
              "Or": [
                {"Variable": "$.orchestrate.input.delta.size", "NumericGreaterThan": 0},
                {"Variable": "$.orchestrate.input.delta.retry_size", "NumericGreaterThan": 0}
              ]
            },
            {
              "Or": [
                {"Variable": "$.assign_envelope.input_hash.S", "StringMatches": "skipped:*"},
                {"Variable": "$.rollup_envelope.input_hash.S", "StringMatches": "skipped:*"}
              ]
            }
          ],
          "Next": "NotifyStageSkipAnomaly"
        }
      ],
      "Default": "End"
    },

    "NotifyStageSkipAnomaly": {
      "Type": "Task",
      "Comment": "#121 — best-effort stage-skip alert to Teams via the alert dispatcher. Passes the triggering run under hot_run; the dispatcher (stage_skip.resolve) reads recent hot_run history and classifies WARN (this run skipped a stage) or ERROR (a streak of work-present runs all skipped). Terminal and Catches to End: the hot_run complete row is already written, so an alerting fault must never flip a completed run's execution to failed.",
      "Resource": "${AlertDispatcherLambdaArn}",
      "Parameters": {
        "source": "hot_path.stage_skip",
        "execution_arn.$": "$$.Execution.Id",
        "hot_run": {
          "run_id.$": "$.orchestrate.input.run_id",
          "started_at.$": "$.orchestrate.input.started_at",
          "delta_size.$": "$.orchestrate.input.delta.size",
          "retry_size.$": "$.orchestrate.input.delta.retry_size",
          "assign_input_hash.$": "$.assign_envelope.input_hash.S",
          "rollup_input_hash.$": "$.rollup_envelope.input_hash.S"
        }
      },
      "ResultPath": null,
      "Retry": [
        {
          "ErrorEquals": ["Lambda.ServiceException", "Lambda.AWSLambdaException", "Lambda.SdkClientException"],
          "IntervalSeconds": 10,
          "MaxAttempts": 2,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "End"
        }
      ],
      "End": true
    },

    "WriteHotRunFailed": {
      "Type": "Task",
      "Resource": "arn:aws:states:::dynamodb:putItem",
      "Parameters": {
        "TableName": "reciterai",
        "Item": {
          "PK": {"S": "STAGE#hot_run#GLOBAL"},
          "SK.$": "States.Format('RUN#FAILED#{}', $$.Execution.StartTime)",
          "stage": {"S": "hot_run"},
          "scope": {"S": "GLOBAL"},
          "status": {"S": "failed"},
          "run_id.$": "$$.Execution.Name",
          "error": {"S.$": "States.JsonToString($.error)"}
        }
      },
      "ResultPath": null,
      "Next": "NotifyError"
    },

    "NotifyError": {
      "Type": "Task",
      "Resource": "${AlertDispatcherLambdaArn}",
      "Parameters": {
        "severity": "ERROR",
        "source": "hot_path",
        "title": "Hot path failure",
        "message.$": "$.error.Cause",
        "execution_arn.$": "$$.Execution.Id"
      },
      "ResultPath": null,
      "End": true
    },

    "End": {
      "Type": "Succeed"
    }
  }
}
