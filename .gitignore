out/
.clone/

# Lambda zip build artifacts — scripts/build_lambda_zips.sh staging + zips
build/

# Editor / OS noise
.DS_Store
.idea/
.vscode/
*.swp
*~

# Local-only Claude config (per repo)
.claude/

# GSD planning workspace — local planning scratch (ROADMAP, STATE, POLICIES,
# issues). Not tracked in this repo.
.planning/

# Bulk data archives
*.xlsx
*.parquet

# Large generated CSVs (keep small fixtures explicitly tracked)
/cwid_*.csv
/cwid_*.json
/faculty_subtopic_counts_*.csv

# Migration diff logs (operator-generated; not for source control)
spotlight_history_migration_*.log
topic_hierarchy_version_backfill_*.log

# Debug/spike scripts under scripts/debug/ ARE tracked; their generated
# JSON result dumps are not.
scripts/debug/*.json

# Architecture diagrams: commit the SVGs, regenerate PNGs locally
docs/architecture/*.png

# Playwright MCP working artifacts (screenshots, transcripts)
.playwright-mcp/
gallery-view*.png

# score_new_topics.py local run checkpoints (run artifacts, not source)
score_new_topics_checkpoint.json
*_scoring_ckpt.json
